# =============================================================================
# JATO Fullstack Backend — environment template
# =============================================================================
# Copy to /etc/jato-fullstack/backend.env and REPLACE the placeholder values.
# This file is checked into Git and MUST NOT contain real secrets.
#
# Used by:
#   systemd  → jato-fullstack-backend@.service
#   systemd  → jato-country-news-sync.service
#   systemd  → jato-voc-forum-sync.service
# =============================================================================

# --- Auth ---
APP_AUTH_ENABLED=false
# APP_AUTH_TOKEN=replace-on-server-only

# --- Server ---
APP_BACKEND_WORKERS=2
APP_PROJECT_ROOT=/opt/JATO_Analysis_System-main

# --- Data paths ---
JATO_PARQUET_PATH=/opt/JATO_Analysis_System-main/04_Processed_data/jato_full_archive.parquet
JATO_PARTITIONED_PATH=/opt/JATO_Analysis_System-main/04_Processed_data/partitioned_dataset_v1
APP_CRUD_DATA_PATH=/opt/JATO_Analysis_System-main/04_Processed_data/app_entities.json
APP_ENGINEERING_IMPORT_ROOT=/opt/JATO_Analysis_System-main/01_RAW_DATA

# --- Database (REQUIRED for News/VOC scheduled fetch) ---
# Set these on the server. The default is OFF so that a deploy without manual
# configuration does not silently connect to the wrong database.
APP_DATABASE_ENABLED=false
# APP_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/jato
APP_DATABASE_ECHO=false

# --- Startup validation ---
# warn = log non-fatal config issues; strict = fail startup for production-required
# missing values. APP_DATABASE_ENABLED=true with empty APP_DATABASE_URL always fails.
APP_STARTUP_VALIDATION_MODE=warn

# --- Hermes Ops Runner ---
# false disables POST /v1/hermes/run/* and /v1/hermes/commands/execute while
# keeping Hermes dashboards, Sentinel, and read APIs available.
HERMES_RUN_ENABLED=false

# --- Country Copilot LLM — DeepSeek only ---
# deepseek-chat = DeepSeek V4-Flash: ¥1/1M input, ¥0.2/1M cache hit, ¥2/1M output, 1M context
APP_COUNTRY_COPILOT_ENABLED=true
# Set true on production if Country Copilot should be considered unavailable
# without an LLM key.
APP_COUNTRY_COPILOT_REQUIRE_LLM_KEY=false
APP_COUNTRY_CHAT_MODEL_OPTIONS=deepseek:deepseek-chat
# DEEPSEEK_API_KEY=sk-...
APP_COUNTRY_CHAT_DEEPSEEK_TIMEOUT_SECONDS=8

# --- Google OAuth (REQUIRED for Google Sign-In) ---
# Set all four on the server and in GitHub Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET).
# GOOGLE_REDIRECT_URI and APP_FRONTEND_ORIGIN are injected automatically by CI with the
# production values below — only change them if the domain or callback path changes.
# APP_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# APP_GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# APP_GOOGLE_REDIRECT_URI=https://www.ojeur.cloud/v1/auth/google/callback
# APP_FRONTEND_ORIGIN=https://www.ojeur.cloud
# Tencent Cloud mainland needs the local mihomo proxy for oauth2.googleapis.com.
# Leave blank outside mainland China if direct Google outbound works.
APP_GOOGLE_OAUTH_PROXY_URL=http://127.0.0.1:7897
APP_GOOGLE_OAUTH_TIMEOUT_SECONDS=30

# --- Other LLM keys (optional) ---
# NVIDIA_API_KEY=
# NVAPI_KEY=
# GEMINI_API_KEY=
