# Example environment for jato-fullstack-backend@.service.
# Deploy marker: monthly update overlap replacement fix.
APP_AUTH_ENABLED=false
APP_AUTH_TOKEN=replace-on-server-only
APP_BACKEND_WORKERS=2
APP_PROJECT_ROOT=/opt/JATO_Analysis_System-main
JATO_PARQUET_PATH=/opt/JATO_Analysis_System-main/04_Processed_data/jato_full_archive.parquet
JATO_PARTITIONED_PATH=/opt/JATO_Analysis_System-main/04_Processed_data/partitioned_dataset_v1
APP_CRUD_DATA_PATH=/opt/JATO_Analysis_System-main/04_Processed_data/app_entities.json
APP_ENGINEERING_IMPORT_ROOT=/opt/JATO_Analysis_System-main/01_RAW_DATA
APP_DATABASE_ENABLED=false
APP_DATABASE_URL=
APP_DATABASE_ECHO=false

# Country Copilot LLM execution chain (deepseek first for report-quality answers).
# deepseek-chat = DeepSeek V4-Flash: ¥1/1M input, ¥2/1M output, 1M context
APP_COUNTRY_CHAT_MODEL_OPTIONS=deepseek:deepseek-chat,nvidia:*,gemini:*
APP_NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
APP_GEMINI_CHAT_MODEL=gemini-2.5-flash
# DeepSeek API key (required for report-first Country Copilot)
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_TIMEOUT_SECONDS=90
# NVIDIA_API_KEY=
# NVAPI_KEY=
# GEMINI_API_KEY=
