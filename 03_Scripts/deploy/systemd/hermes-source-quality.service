[Unit]
Description=Hermes Intelligence Governor — daily source quality audit
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/JATO_Analysis_System-main
Environment=PYTHONUNBUFFERED=1
Environment=APP_ENV=production
ExecStart=/opt/JATO_Analysis_System-main/.venv/bin/python 03_Scripts/hermes/hermes_source_quality.py

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
