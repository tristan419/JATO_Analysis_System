# Copy to /etc/jato-fullstack/country-news.env
# Used by:
#   systemd  → jato-country-news-sync.service
#   shell    → 03_Scripts/run_country_news_sync.sh

# Sync arguments passed to sync_country_news_digest.py.
# Default is "--workers 4". Use "--no-gemini" to skip enrichment.
JATO_COUNTRY_NEWS_SYNC_ARGS="--workers 4"

# Python binary override (default: $REPO_DIR/.venv/bin/python).
# JATO_COUNTRY_NEWS_PYTHON=/opt/JATO_Analysis_System/.venv/bin/python

# Database must be enabled in backend.env for real persistence.
# APP_DATABASE_ENABLED=true
# APP_DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/jato

# Gemini API key for digest enrichment (optional).
# GEMINI_API_KEY=

# Alert configuration (macOS only for notification; email works on Linux too).
JATO_COUNTRY_NEWS_ALERT_EMAIL=
JATO_COUNTRY_NEWS_ALERT_NOTIFY=true
# JATO_COUNTRY_NEWS_ALERT_MAIL_BIN=mail
