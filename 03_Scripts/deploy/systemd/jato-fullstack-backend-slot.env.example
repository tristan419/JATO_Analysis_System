# =============================================================================
# JATO Fullstack Backend — per-slot environment template
# =============================================================================
# Install one concrete file for each slot:
#   /etc/jato-fullstack/slots/8000.env
#   /etc/jato-fullstack/slots/8001.env
#
# The release controller replaces __SLOT__ and __RELEASE_SHA__ atomically.
# Shared secrets and database settings stay in /etc/jato-fullstack/backend.env.
# =============================================================================

APP_RELEASE_SLOT=__SLOT__
APP_RELEASE_SHA=__RELEASE_SHA__
APP_PROJECT_ROOT=/opt/jato/slots/__SLOT__/current
PYTHONPATH=/opt/jato/slots/__SLOT__/current/06_AppPlatform/backend
PYTHONDONTWRITEBYTECODE=1
APP_BACKEND_WORKERS=2
APP_JATO_MONTHLY_ENABLED=true
APP_JATO_MONTHLY_UPDATE_JOB_ROOT=/opt/jato/shared/04_Processed_data/ops/jato_monthly_update_jobs
APP_JATO_MONTHLY_ACTIVE_SLOT_FILE=/var/lib/jato-release/active-slot
APP_JATO_MONTHLY_DEPLOYMENT_MARKER=/var/lib/jato-release/deployment-maintenance

# Durable data is shared by the slots. The release controller must verify that
# these paths are not inside an immutable release directory.
JATO_PARQUET_PATH=/opt/jato/shared/04_Processed_data/jato_full_archive.parquet
JATO_PARTITIONED_PATH=/opt/jato/shared/04_Processed_data/partitioned_dataset_v1
APP_CRUD_DATA_PATH=/opt/jato/shared/04_Processed_data/app_entities.json
APP_ENGINEERING_IMPORT_ROOT=/opt/jato/shared/01_RAW_DATA
MSRP_GOVERNANCE_EVIDENCE_ROOT=/opt/jato/shared/04_Processed_data/ops/msrp_source_evidence

# Candidate validation must override all of these to false. The active slot may
# restore the configured values only after the old slot has drained and stopped.
APP_GROUPED_TIME_SERIES_PREWARM_ENABLED=false
APP_DASHBOARD_OVERVIEW_PREWARM_ENABLED=false
APP_METADATA_PREWARM_ENABLED=false
APP_ADVANCED_ANALYSIS_WARMUP_ENABLED=false

# Candidate safety is enforced by the dynamic active-slot + deployment-marker
# gate. Keeping subprocess mode here lets the already-verified process become
# active without a restart; the inactive candidate still returns HTTP 423 and
# both final spawn points fail closed.
APP_JATO_MONTHLY_EXECUTION_MODE=subprocess
HERMES_RUN_ENABLED=false
