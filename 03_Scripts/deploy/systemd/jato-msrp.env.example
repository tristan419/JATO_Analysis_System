# Copy to /etc/jato-fullstack/msrp.env and load with
# bash 03_Scripts/run_msrp_low_concurrency.sh

JATO_MSRP_MODE=dryrun
JATO_MSRP_COUNTRIES=se,hr,hu,no,at,cz,ch
JATO_MSRP_PAUSE_SECONDS=20
JATO_MSRP_STOP_ON_FAILURE=true
JATO_STRICT_EXIT=true

# Override only if your backend does not live on 127.0.0.1:8000.
JATO_API_BASE=http://127.0.0.1:8000/v1
APP_USER_NAME=msrp-cron

# Usually inherited from /etc/jato-fullstack/backend.env.
# APP_AUTH_TOKEN=replace-with-backend-token

# Optional for manual LLM diagnosis on Tencent Cloud.
# NVIDIA_API_KEY=
# NVAPI_KEY=
# HF_TOKEN=