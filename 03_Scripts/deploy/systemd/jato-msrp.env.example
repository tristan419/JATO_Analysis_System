# Copy to /etc/jato-fullstack/msrp.env.
# Used by:
#   systemd  → jato-msrp-sync@dryrun.service / jato-msrp-sync@ingest.service
#   shell    → 03_Scripts/run_msrp_low_concurrency.sh
#   shell    → bash 03_Scripts/run_msrp_pipeline.sh for dryrun→gate→ingest smoke

# Manual shell runs can still override JATO_MSRP_MODE here, but the systemd
# instance name wins for the nightly timers.
JATO_MSRP_MODE=dryrun
JATO_MSRP_EXECUTION_CONTEXT=systemd_scheduled
JATO_MSRP_COUNTRIES=se,hr,hu,no,at,cz,ch
# Optional full-pipeline wrapper override. Defaults to JATO_MSRP_COUNTRIES.
# JATO_MSRP_PIPELINE_COUNTRIES=se,fi
# JATO_MSRP_PIPELINE_SKIP_DRYRUN=false
# JATO_MSRP_PIPELINE_SKIP_INGEST=false
JATO_MSRP_CONCURRENCY=2
JATO_MSRP_MAX_DRYRUN_CONCURRENCY=2
# Set true only after dryrun pass rates are stable at low concurrency.
JATO_MSRP_ALLOW_HIGH_CONCURRENCY=false
JATO_MSRP_PAUSE_SECONDS=20
JATO_MSRP_STOP_ON_FAILURE=true
JATO_MSRP_COUNTRY_TIMEOUT_SECONDS=3600
JATO_STRICT_EXIT=true
JATO_MSRP_AUTO_REVIEW=false
JATO_MSRP_AUTO_MATERIALIZE=false

# Ingest auto-review gate. Keep high enough that weak matches stay open for
# human review; individual signal weights can be overridden with
# JATO_MSRP_AUTO_REVIEW_WEIGHT_RESOLVER, _MATCH_CONFIDENCE, _SOURCE_TIER,
# and _COMPLETENESS.
JATO_MSRP_AUTO_REVIEW_MIN_SCORE=70

# Override only if your backend does not live on 127.0.0.1:8000.
JATO_API_BASE=http://127.0.0.1:8000/v1
APP_USER_NAME=msrp-cron

# Usually inherited from /etc/jato-fullstack/backend.env.
# APP_AUTH_TOKEN=replace-with-backend-token

# Python binary override (default: $REPO_DIR/.venv/bin/python).
# JATO_MSRP_PYTHON=/opt/JATO_Analysis_System-main/.venv/bin/python

# Optional for manual LLM diagnosis on Tencent Cloud.
# NVIDIA_API_KEY=
# NVAPI_KEY=
# HF_TOKEN=

# Optional proxy override. Leave unset for direct official-site access.
# http_proxy=http://127.0.0.1:7897
# https_proxy=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
