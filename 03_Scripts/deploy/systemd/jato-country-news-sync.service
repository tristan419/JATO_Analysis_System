[Unit]
Description=JATO Country News Sync (one-shot prefetch to PostgreSQL)
After=network.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/opt/JATO_Analysis_System-main

# Recommended: run as a non-root user.
# User=deploy
# Group=deploy

EnvironmentFile=-/etc/jato-fullstack/backend.env
EnvironmentFile=-/etc/jato-fullstack/country-news.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/JATO_Analysis_System-main/06_AppPlatform/backend
Environment=REPO_DIR=/opt/JATO_Analysis_System-main
Environment=http_proxy=http://127.0.0.1:7897
Environment=https_proxy=http://127.0.0.1:7897
Environment=HTTP_PROXY=http://127.0.0.1:7897
Environment=HTTPS_PROXY=http://127.0.0.1:7897

ExecStart=/opt/JATO_Analysis_System-main/03_Scripts/run_country_news_sync.sh

# Allow up to 30 minutes for all countries.
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
