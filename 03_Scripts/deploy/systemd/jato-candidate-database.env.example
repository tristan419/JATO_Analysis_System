# Bootstrap example for the Tencent host. Install as:
#   /etc/jato-fullstack/candidate-database.env (root:root, mode 0600)
#
# The controller reuses this dedicated Candidate role credential, replaces the
# database path with a generated jato_candidate_* sandbox, then adds snapshot
# metadata and an independent JWT secret. The bootstrap database path should
# not exist, so starting 8001 before a successful prepare fails closed. The
# role must connect to Candidate sandboxes, while PostgreSQL denies it CONNECT
# on the Active database.
APP_DATABASE_ENABLED=true
APP_DATABASE_URL=postgresql+asyncpg://jato_candidate:REPLACE_ME@127.0.0.1:5432/jato_candidate_bootstrap_disabled
APP_AUTH_ENABLED=false
APP_RUNTIME_READ_ONLY=false
