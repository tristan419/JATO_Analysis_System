# Required only on the Tencent host at:
#   /etc/jato-fullstack/candidate-database.env
#
# Create a dedicated PostgreSQL role with CONNECT/USAGE/SELECT only. It must
# not be the Active application's database role. Keep the real file root-owned
# and mode 0600; never commit its credentials.
APP_DATABASE_ENABLED=true
APP_DATABASE_URL=postgresql+asyncpg://jato_candidate_readonly:REPLACE_ME@127.0.0.1:5432/jato
