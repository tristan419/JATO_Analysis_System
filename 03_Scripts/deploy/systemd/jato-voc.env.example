# Copy to /etc/jato-fullstack/voc.env
# Used by:
#   systemd  → jato-voc-forum-sync.service
#   shell    → 03_Scripts/run_voc_forum_sync.sh

# Batch YAML files relative to the repo root.
JATO_VOC_BATCH_FILES="07_ScrapingToolkit/voc_sources/batch_a.yaml"

# Default nightly countries for the first production window.
JATO_VOC_COUNTRIES="SE,FI,NO,DK,AT,CZ,HR,HU"

# Root directory that keeps the live forum VOC artifacts on Tencent Cloud.
JATO_VOC_OUTPUT_ROOT="04_Processed_data/voc"

# Fetch-time knobs.
JATO_VOC_MAX_LINKS_PER_SOURCE=4
JATO_VOC_TIMEOUT_SECONDS=20

# Production target shape follows the VOC docs:
# raw artifact -> PG staging sync -> enriched signals -> country deck.
JATO_VOC_SYNC_TO_STORE=true
JATO_VOC_ENRICH=true

# Python binary override (default: $REPO_DIR/.venv/bin/python).
# JATO_VOC_PYTHON=/opt/JATO_Analysis_System-main/.venv/bin/python