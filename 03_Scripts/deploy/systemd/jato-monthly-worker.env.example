# Copy to /etc/jato-fullstack/monthly-worker.env after measuring the host with:
# /opt/JATO_Analysis_System-main/.venv/bin/python 03_Scripts/ops/jato_monthly_worker_capacity.py
# Zero leaves the process-level limit unset; use a reviewed systemd drop-in for
# the cgroup MemoryHigh/MemoryMax values selected from the capacity report.
APP_JATO_MONTHLY_WORKER_MEMORY_LIMIT_BYTES=0
APP_JATO_MONTHLY_WORKER_CPU_LIMIT_SECONDS=0
