{
  "version": "2.0",
  "statement": [
    {
      "effect": "allow",
      "action": [
        "name/cos:HeadObject",
        "name/cos:GetObject"
      ],
      "resource": [
        "qcs::cos:<REGION>:uid/<APPID>:<BUCKET-APPID>/releases/*",
        "qcs::cos:<REGION>:uid/<APPID>:<BUCKET-APPID>/rollback/*"
      ],
      "condition": {
        "bool_equal": {
          "cos:secure-transport": "true"
        }
      }
    },
    {
      "effect": "deny",
      "action": [
        "name/cos:HeadObject",
        "name/cos:GetObject"
      ],
      "resource": [
        "qcs::cos:<REGION>:uid/<APPID>:<BUCKET-APPID>/releases/*",
        "qcs::cos:<REGION>:uid/<APPID>:<BUCKET-APPID>/rollback/*"
      ],
      "condition": {
        "bool_equal": {
          "cos:secure-transport": "false"
        }
      }
    }
  ]
}
