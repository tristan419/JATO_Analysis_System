{
  "version": "2.0",
  "statement": [
    {
      "effect": "allow",
      "action": [
        "name/cos:HeadObject",
        "name/cos:UploadPart",
        "name/cos:AbortMultipartUpload"
      ],
      "resource": [
        "qcs::cos:<REGION>:uid/<APPID>:<BUCKET-APPID>/releases/*"
      ],
      "condition": {
        "bool_equal": {
          "cos:secure-transport": "true"
        }
      }
    },
    {
      "effect": "allow",
      "action": [
        "name/cos:InitiateMultipartUpload",
        "name/cos:CompleteMultipartUpload"
      ],
      "resource": [
        "qcs::cos:<REGION>:uid/<APPID>:<BUCKET-APPID>/releases/*"
      ],
      "condition": {
        "bool_equal": {
          "cos:secure-transport": "true"
        },
        "string_equal": {
          "cos:x-cos-forbid-overwrite": "true"
        }
      }
    },
    {
      "effect": "deny",
      "action": [
        "name/cos:InitiateMultipartUpload",
        "name/cos:CompleteMultipartUpload"
      ],
      "resource": [
        "qcs::cos:<REGION>:uid/<APPID>:<BUCKET-APPID>/releases/*"
      ],
      "condition": {
        "string_not_equal_if_exist": {
          "cos:x-cos-forbid-overwrite": "true"
        }
      }
    },
    {
      "effect": "deny",
      "action": [
        "name/cos:HeadObject",
        "name/cos:InitiateMultipartUpload",
        "name/cos:UploadPart",
        "name/cos:CompleteMultipartUpload",
        "name/cos:AbortMultipartUpload"
      ],
      "resource": [
        "qcs::cos:<REGION>:uid/<APPID>:<BUCKET-APPID>/releases/*"
      ],
      "condition": {
        "bool_equal": {
          "cos:secure-transport": "false"
        }
      }
    }
  ]
}
